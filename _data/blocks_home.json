    "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap\" rel=\"stylesheet\">\n<style>\n.rf{--ink:#141414;--cream:#f6f2ec;--gold:#8a6d3b;--gold2:#b08d57;--mut:#5b5650;--line:#e4ddd2;--serif:'Playfair Display',Georgia,serif;--sans:'Inter',system-ui,sans-serif;font-family:var(--sans);color:var(--ink)}\n.rf *{box-sizing:border-box}\n.rf-wrap{max-width:1180px;margin:0 auto;padding:0 1.5rem}\n.rf-eyebrow{font-size:.78rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:600;margin:0 0 1rem}\n.rf-h2{font-family:var(--serif);font-weight:500;font-size:clamp(1.8rem,3.4vw,2.7rem);line-height:1.15;margin:0 0 .75rem;color:var(--ink)}\n.rf-lead{font-size:1.08rem;line-height:1.7;color:var(--mut);max-width:58ch;margin:0}\n.rf-sec{padding:clamp(3rem,7vw,5.5rem) 0}.rf-sec-c{background:var(--cream)}\n.rf-btn{display:inline-flex;align-items:center;min-height:48px;padding:.8rem 1.7rem;font:600 .86rem var(--sans);letter-spacing:.14em;text-transform:uppercase;text-decoration:none;border:1px solid var(--ink);transition:background .2s,color .2s}\n.rf-btn-k{background:var(--ink);color:#fff}.rf-btn-k:hover{background:#fff;color:var(--ink)}\n.rf-btn-o{color:var(--ink);background:transparent}.rf-btn-o:hover{background:var(--ink);color:#fff}\n.rf-btn:focus-visible,.rf a:focus-visible{outline:3px solid var(--gold2);outline-offset:3px}\n.rf-hero{background:var(--cream);padding:clamp(2rem,5vw,4rem) 0}\n.rf-hero-in{display:grid;grid-template-columns:1.05fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}\n.rf-hero h1{font-family:var(--serif);font-weight:500;font-size:clamp(2.4rem,5.4vw,4.6rem);line-height:1.04;margin:0 0 1.25rem;letter-spacing:-.01em;text-wrap:balance}\n.rf-hero h1 em{color:var(--gold);font-style:italic}\n.rf-hero p{font-size:1.15rem;line-height:1.7;color:var(--mut);max-width:44ch;margin:0 0 2rem}\n.rf-act{display:flex;gap:.9rem;flex-wrap:wrap}\n.rf-hero-fig{margin:0;display:grid;grid-template-columns:1fr 1fr;gap:.8rem}\n.rf-hero-fig img{width:100%;height:100%;object-fit:cover;display:block}\n.rf-hero-fig .a{grid-row:span 2;aspect-ratio:3/4.4}.rf-hero-fig .b,.rf-hero-fig .c{aspect-ratio:1/1}\n.rf-cats{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:2.2rem}\n.rf-cat{position:relative;display:block;aspect-ratio:4/5;overflow:hidden;background:#222;color:#fff;text-decoration:none}\n.rf-cat img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.78;transition:transform .5s,opacity .3s}\n.rf-cat:hover img{transform:scale(1.04);opacity:.9}\n.rf-cat-t{position:absolute;left:0;right:0;bottom:0;padding:3rem 1.1rem 1.1rem;background:linear-gradient(transparent,rgba(0,0,0,.8))}\n.rf-cat-t b{display:block;font-family:var(--serif);font-weight:500;font-size:1.35rem;color:#fff}\n.rf-cat-t span{font-size:.86rem;color:#f0ebe3}\n.rf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2.2rem 1.6rem;margin-top:2.2rem}\n.rf-card{display:flex;flex-direction:column;text-decoration:none;color:var(--ink)}\n.rf-card-im{display:block;aspect-ratio:4/3;overflow:hidden;background:var(--cream);margin-bottom:1rem}\n.rf-card-im img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}\n.rf-card:hover .rf-card-im img{transform:scale(1.04)}\n.rf-card-cat{font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:.45rem}\n.rf-card-t{font-family:var(--serif);font-size:1.3rem;line-height:1.25;font-weight:500;margin-bottom:.5rem}\n.rf-card:hover .rf-card-t{text-decoration:underline;text-underline-offset:4px}\n.rf-card-d{font-size:.95rem;line-height:1.6;color:var(--mut)}\n.rf-head{display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;flex-wrap:wrap}\n.rf-link{font:600 .82rem var(--sans);letter-spacing:.14em;text-transform:uppercase;color:var(--ink);border-bottom:1px solid var(--ink);padding-bottom:3px;text-decoration:none}\n.rf-2c{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:center}\n.rf-2c img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}\n.rf-dark{background:var(--ink);color:#fff;text-align:center}.rf-dark .rf-h2{color:#fff}.rf-dark .rf-lead{color:#d9d3c8;margin:0 auto 2rem}.rf-dark .rf-eyebrow{color:var(--gold2)}\n.rf-dark .rf-btn{background:#fff;color:var(--ink);border-color:#fff}.rf-dark .rf-btn:hover{background:transparent;color:#fff}\n.rf-shop{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-top:2.2rem}.rf-sh{display:flex;flex-direction:column;justify-content:flex-end;min-height:230px;padding:1.4rem;background:var(--cream);border:1px solid var(--line);text-decoration:none;color:var(--ink);transition:border-color .2s}.rf-sh:hover{border-color:var(--ink)}.rf-sh b{font-family:var(--serif);font-weight:500;font-size:1.7rem;margin-bottom:.4rem}.rf-sh span{font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);font-weight:600}\n@media(max-width:900px){.rf-shop{grid-template-columns:repeat(2,1fr)}.rf-hero-in,.rf-2c{grid-template-columns:1fr}.rf-cats{grid-template-columns:repeat(2,1fr)}.rf-grid{grid-template-columns:repeat(2,1fr)}}\n@media(max-width:560px){.rf-grid{grid-template-columns:1fr}.rf-hero-fig .a{aspect-ratio:3/4}}\n@media(prefers-reduced-motion:reduce){.rf *{transition:none!important}}\n</style><div class=\"rf\"><section class=\"rf-hero\"><div class=\"rf-wrap rf-hero-in\"><div><p class=\"rf-eyebrow\">Moda e lusso italiano</p><h1>Stile italiano, <em>collezioni</em> e storie di moda</h1><p>Abbigliamento, beauty e design di lusso: lo shop sta per aprire. Intanto leggi il Journal, tra stilisti, maison, classifiche e tendenze.</p><div class=\"rf-act\"><a class=\"rf-btn rf-btn-k\" href=\"__BASEURL__/shop/\">Scopri lo shop</a><a class=\"rf-btn rf-btn-o\" href=\"__BASEURL__/blog/\">Leggi il Journal</a></div></div><figure class=\"rf-hero-fig\"><img class=\"a\" src=\"__BASEURL__/assets/posts/yves-saint-laurent/yves.jpg\" alt=\"Yves Saint Laurent\"><img class=\"b\" src=\"__BASEURL__/assets/posts/gianni-versace/gianni-e-donatella-versace.jpg\" alt=\"Gianni Versace\"><img class=\"c\" src=\"__BASEURL__/assets/posts/moda-mare-costumi-piu-trendy-2023/summer-fashion.jpeg\" alt=\"Moda mare: i costumi più trendy del 2023\"></figure></div></section></div>"
